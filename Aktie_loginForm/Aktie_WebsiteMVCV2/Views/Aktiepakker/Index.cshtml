@model Aktie_WebsiteMVCV2.DTO.Stock.AktiepakkeView

@{
    ViewData["Title"] = "Aktiepakker";

    int kategoriId = Model.KategoriId;

    string pakkeNavn = kategoriId switch
    {
        1 => "Basis",
        2 => "Pro",
        3 => "Premium",
        _ => ""
    };

    string beskrivelse = $"Adgang til {Model.MaxUsers} aktier";

    string pris = kategoriId switch
    {
        1 => "49 kr / måned",
        2 => "89 kr / måned",
        3 => "149 kr / måned",
        _ => ""
    };
}

@if (TempData["SuccessMessage"] != null)
{
    <div style="background-color:#d4edda; padding:10px; border-radius:5px; margin-bottom:15px;">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background-color:#f8d7da; color:#721c24; padding:10px; border-radius:5px; margin-bottom:15px;">
        @TempData["Error"]
    </div>
}

<h1>@pakkeNavn aktiepakker</h1>

<p>Her kan du vælge en aktiepakke, der passer til dit abonnement.</p>

<div style="border:1px solid #ccc; border-radius:8px; padding:20px; margin-top:20px; max-width:650px;">

    <h2>@pakkeNavn aktiepakke</h2>

    <p>@beskrivelse</p>
    <p><strong>@pris</strong></p>

    <p>
        Pladser:
        <strong>@Model.CurrentUsers</strong> /
        <strong>@Model.MaxUsers</strong>
    </p>

    <p>
        Ledige pladser:
        <strong>@Model.LedigePladser</strong>
    </p>

    <h3>Aktier i pakken</h3>

    @if (Model.Stocks == null || !Model.Stocks.Any())
    {
        <p>Ingen aktier fundet.</p>
    }
    else
    {
        <table border="1" cellpadding="10" style="width:100%; margin-bottom:20px;">
            <thead>
                <tr>
                    <th>Symbol</th>
                    <th>Pris</th>
                    <th>Ændring</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stock in Model.Stocks)
                {
                    <tr>
                        <td>@stock.Symbol</td>
                        <td>@stock.Price</td>
                        <td>@stock.ChangePercent</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <form method="post" asp-controller="Abonnement" asp-action="Buy">
        <input type="hidden" name="pakkeId" value="@pakkeNavn" />

        <button type="submit" class="btn btn-success">
            Køb aktiepakke
        </button>
    </form>
</div>

<br />

<a asp-controller="Abonnement" asp-action="Abonnement">
    ← Tilbage til abonnement
</a>